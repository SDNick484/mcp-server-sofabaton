# /etc/mcp-server-sofabaton/env: read by run.sh (root:mcp-sofabaton, mode 0640).
# Plain KEY=value lines. Every setting lives here: Sofabaton keeps no other state.
# Keep the MQTT password out of this file: put it in mqtt-password next to it.

# --- the hub ----------------------------------------------------------------------------
# sofabaton-x-server (any model). "none" for an X2 over MQTT only.
SOFABATON_URL=http://localhost:8480
#SOFABATON_HUB="Living Room"          # only if the server manages several hubs (quote spaces)

# X2 only: the broker the X2 is linked to (Sofabaton app: Me -> Connect to Home Assistant).
#SOFABATON_MQTT_URL=mqtt://sofabaton@192.168.1.10:1883
#SOFABATON_MQTT_PASSWORD_FILE=/etc/mcp-server-sofabaton/mqtt-password
#SOFABATON_MQTT_MAC=02:AB:34:CD:56:EF # needed with SOFABATON_URL=none; learned from the server otherwise
#SOFABATON_MQTT_SETTLE_S=6

# --- HTTP and Cloudflare Access ----------------------------------------------------------
# Where to listen. 127.0.0.1 if cloudflared runs in the same LXC (recommended);
# the LXC's address if cloudflared runs elsewhere (then Access is required).
MCP_HTTP_BIND=127.0.0.1
MCP_HTTP_PORT=8714
MCP_HTTP_PATH=/sofabaton/mcp
# The public hostname Cloudflare forwards (Host header checks).
#MCP_PUBLIC_HOSTS=mcp.example.com

# Cloudflare Access (required for any non-loopback bind).
#CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
#CF_ACCESS_AUD=<the Access application's AUD tag>
#MCP_ALLOWED_EMAILS=you@example.com

# Optional
#SOFABATON_DRY_RUN=1    # read the hub, send nothing that changes anything
#MCP_SERVE_ARGS=--no-redact
