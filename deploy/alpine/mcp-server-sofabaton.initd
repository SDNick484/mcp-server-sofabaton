#!/sbin/openrc-run
# OpenRC service for mcp-server-sofabaton (Streamable HTTP), e.g. in an Alpine LXC.
# Installed as /etc/init.d/mcp-server-sofabaton by install.sh. Every setting
# (sofabaton-x-server URL, MQTT broker, HTTP and Cloudflare Access) lives in
# /etc/mcp-server-sofabaton/env; the broker password, if any, in mqtt-password
# next to it.

name="mcp-server-sofabaton"
description="MCP server for Sofabaton X1/X1S/X2 hubs, over Streamable HTTP"

# supervise-daemon restarts the server if it exits (respawn_* below).
supervisor="supervise-daemon"
# run.sh loads /etc/mcp-server-sofabaton/env, then execs `mcp-server-sofabaton serve --http`.
command="/opt/mcp-server-sofabaton/run.sh"
command_user="mcp-sofabaton:mcp-sofabaton"
directory="/var/lib/mcp-server-sofabaton"
output_log="/var/log/mcp-server-sofabaton/server.log"
error_log="/var/log/mcp-server-sofabaton/server.log"
respawn_delay=5
respawn_max=10
respawn_period=300

# Stopping: SIGTERM, up to 15 s to shut down cleanly, then SIGKILL (OpenRC's default is SIGTERM/5).
# Shutdown is usually about 2 s, but at worst about 20 s: uvicorn's 2 s drain, then the identity
# and MQTT tasks get 5 s each and the hub connection up to 8 s, in turn. So a hung broker or hub
# can still end in SIGKILL.
# supervise-daemon reads this at start: the restart that installs it still stops the old way.
retry="SIGTERM/15/SIGKILL/5"

depend() {
	need net
	after firewall
}

start_pre() {
	checkpath --directory --mode 0750 --owner mcp-sofabaton:mcp-sofabaton /var/log/mcp-server-sofabaton
	checkpath --directory --mode 0700 --owner mcp-sofabaton:mcp-sofabaton /var/lib/mcp-server-sofabaton
}
